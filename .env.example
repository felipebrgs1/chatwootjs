# Copie para `.env` na raiz e ajuste. É o ÚNICO .env do monorepo
# (front + back). Não existem mais `apps/server/.env` nem `apps/web/.env`.

# Postgres local (dev sem docker)
DATABASE_URL=postgresql://postgres:password@localhost:5432/chatwootjs

# Hono: origem liberada no CORS (URL do dashboard web)
CORS_ORIGIN=http://localhost:3001

# Web (Vite): URL da API (embutida no build)
VITE_SERVER_URL=http://localhost:3000

# Senha do Postgres (docker-compose)
POSTGRES_PASSWORD=password

# Redis 8: jobs BullMQ (a partir do M6) + pub/sub realtime (multi-réplica).
# Em dev sem docker, pode ficar vazio — server usa runner/bus in-process.
REDIS_URL=

# Objetos/anexos (ver packages/core/src/lib/storage.ts).
# Vazio = disco local (.uploads). Para S3-compatível (RustFS local ou AWS):
# S3_BUCKET=chatwootjs-uploads
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=rustfsadmin
# AWS_SECRET_ACCESS_KEY=rustfsadmin

# Canais externos (M10) — só preencha os que for usar.
# WhatsApp Cloud + Facebook/Instagram (verify do GET hub.*):
# WHATSAPP_VERIFY_TOKEN=um-segredo-qualquer
# WHATSAPP_API_KEY=<token-meta> (fallback da inbox)
# WHATSAPP_PHONE_NUMBER_ID=<id> (fallback da inbox)
# Evolution API (WhatsApp self-hosted, provider=evolution):
# EVOLUTION_API_URL=https://evo.suaempresa.com
# EVOLUTION_API_KEY=<apikey>
# FACEBOOK_VERIFY_TOKEN=um-segredo-qualquer
# Twitter/X Account Activity API (GET CRC):
# TWITTER_CONSUMER_SECRET=<api-secret-do-app>
# SMS Twilio (fallback da inbox):
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+5511888880000
# WhatsApp via Twilio (provider=twilio; From/To com prefixo whatsapp:):
# TWILIO_WHATSAPP_NUMBER=whatsapp:+5511888880000
# Voice via Twilio (provider de voz na Configuração da inbox):
# TWILIO_VOICE_NUMBER=+5511888880000
# VOICE_TWIML_URL=https://seu-host/webhooks/voice/twiml
# VOICE_STATUS_URL=https://seu-host/webhooks/voice
# WhatsApp via 360Dialog (provider=360dialog):
# D360_API_KEY=<api-key-do-painel-360dialog>
# SMS via Bandwidth (provider=bandwidth):
# BANDWIDTH_ACCOUNT_ID=<account-id>
# BANDWIDTH_API_KEY=<api-token>
# BANDWIDTH_API_SECRET=<api-secret>
# BANDWIDTH_APPLICATION_ID=<application-id>
# BANDWIDTH_PHONE_NUMBER=+5511888880000
